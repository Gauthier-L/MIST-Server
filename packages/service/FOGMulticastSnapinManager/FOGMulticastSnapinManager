#!/usr/bin/php -q
<?php
/**
 * FOGMulticastSnapinManager service executable
 *
 * Follows the same pattern as FOGMulticastManager
 *
 * @category Service
 * @package  FOGProject
 * @author   MIST Team
 * @license  http://opensource.org/licenses/gpl-3.0 GPLv3
 * @link     https://fogproject.org
 */
@error_reporting(0);
require dirname(realpath(__FILE__)).'/../etc/config.php';
require dirname(realpath(__FILE__)).'/../lib/service_lib.php';
$service_name = 'FOGMulticastSnapinManager';
service_persist($service_name);
$ServiceClass = FOGCore::getClass('MulticastSnapinManager');

// Check if udp-sender exists
if (!file_exists(UDPSENDERPATH)) {
    $ServiceClass::outall(' * Unable to locate udp-sender at '.UDPSENDERPATH);
    exit(1);
}

$ServiceClass->getBanner();
$ServiceClass->waitInterfaceReady();
$ServiceClass->waitDbReady();
$ServiceClass->serviceStart();
$ServiceClass->serviceRun();
$ServiceClass::outall(' * Service has ended.');
exit(0);
